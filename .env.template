# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env is gitignored and must never be committed.
#   cp .env.template .env
# ---------------------------------------------------------------------------

# REQUIRED. Get one from the Govee app: Profile -> About Us -> Apply for API Key.
# The key is emailed to you and grants full control over every device on the account.
GOVEE_API_KEY=

# The device to control. Run `npm run devices` to find these values --
# it prints ready-made lines to paste in here.
GOVEE_SKU=
GOVEE_DEVICE=

# Readable names for the HDMI inputs, in name:port form (port 1-4).
# Each name becomes a route, e.g. /apple and /ps5.
# /hdmi1 .. /hdmi4 always exist regardless of this line.
SOURCE_ALIASES=apple:1,ps5:2

# Port the server listens on.
PORT=8088

# Optional. If set, every request needs ?token=... or Authorization: Bearer ...
# Recommended if the Pi is reachable beyond your own network.
AUTH_TOKEN=
