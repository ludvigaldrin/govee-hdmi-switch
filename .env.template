# ---------------------------------------------------------------------------
# Kopiera till .env och fyll i. .env är gitignorerad och ska aldrig checkas in.
#   cp .env.template .env
# ---------------------------------------------------------------------------

# OBLIGATORISK. Hämtas i Govee-appen: Profil -> Om oss -> Apply for API Key.
# Nyckeln mejlas till dig och ger full kontroll över alla enheter på kontot.
GOVEE_API_KEY=

# Enheten som ska styras. Kör `npm run devices` för att hitta värdena --
# den skriver ut färdiga rader att klistra in här.
GOVEE_SKU=
GOVEE_DEVICE=

# Läsbara namn för HDMI-ingångarna, format namn:port (port 1-4).
# Ger en route per namn, t.ex. /apple och /ps5.
# /hdmi1 .. /hdmi4 finns alltid, oavsett den här raden.
SOURCE_ALIASES=apple:1,ps5:2

# Porten servern lyssnar på.
PORT=8088

# Valfritt. Om satt krävs ?token=... eller Authorization: Bearer ... på varje
# anrop. Rekommenderas om Pi:n är nåbar från mer än ditt eget nät.
AUTH_TOKEN=
