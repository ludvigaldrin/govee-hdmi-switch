# Kopiera till /etc/systemd/system/ och justera User/paths om du inte kör som pi.
[Unit]
Description=govee-hdmi-switch - HDMI-kallvaxlare for Govee AI Sync Box
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/govee-hdmi-switch
EnvironmentFile=/home/pi/govee-hdmi-switch/.env
ExecStart=/usr/bin/node /home/pi/govee-hdmi-switch/index.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
