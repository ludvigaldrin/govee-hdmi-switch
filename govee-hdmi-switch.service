# Copy to /etc/systemd/system/ and adjust User/paths if you are not running as pi.
[Unit]
Description=govee-hdmi-switch - HDMI source switcher for Govee AI Sync Box
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/govee-hdmi-switch
EnvironmentFile=/home/pi/govee-hdmi-switch/.env
ExecStart=/usr/bin/node /home/pi/govee-hdmi-switch/index.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
